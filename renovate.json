{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "packages/**/*.yaml"
      ],
      "matchStrings": [
        "ghcr\\.io/esphome/esphome:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/esphome/esphome",
      "datasourceTemplate": "docker",
      "groupNameTemplate": "ESPHome"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        ".github/workflows/config-check.yaml",
        ".github/workflows/config-check.yml"
      ],
      "matchStrings": [
        "ghcr\\.io/esphome/esphome:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/esphome/esphome",
      "datasourceTemplate": "docker",
      "groupNameTemplate": "ESPHome"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "packages/**/*.yaml"
      ],
      "matchStrings": [
        "min_version:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "esphome/esphome",
      "datasourceTemplate": "github-releases"
    }
  ]
}
